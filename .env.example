# Copy to .env.local and fill in. Never commit real values.

# Admin panel password (required in production)
ADMIN_PASSWORD=

# Signs customer login cookies (required in production; any long random string)
SESSION_SECRET=

# Domains → niche (comma-separated host=niche pairs) — required in production
# NICHE_DOMAINS is listed at the bottom

# Only for a demo deployment without Supabase
ALLOW_DEMO_DATA=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram seller bot (from BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Team alerts on Telegram (send /myid to the bot to get your number; several: comma-separated)
ADMIN_TELEGRAM_CHAT_IDS=
# Order team: orders, each step after, and abandoned carts only (no seller-bot alerts).
# A plain number gets every store; coffee:NUMBER gets Cairo Roast only. Several: separate with commas.
TEAM_TELEGRAM_CHAT_IDS=

# Bosta (platform business account)
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
# Optional: override the API base URL
BOSTA_API_BASE=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Meta Conversions API. The pixel id is public and lives in niches/<id>.json (brand.metaPixelId).
# Token: Events Manager → the pixel → Settings → Conversions API → Generate access token. Server only.
META_CAPI_TOKEN=
# Several niches with different pixels: per-niche tokens / pixel ids (niche=value, comma-separated) override the above
META_CAPI_TOKENS=
META_PIXEL_IDS=
# Optional, while testing: the code from Events Manager → Test events (remove it for real traffic)
META_TEST_EVENT_CODE=

# Search engines (optional): verification tokens from Google Search Console / Bing Webmaster Tools
# (one token for all sites, or niche=token pairs). Google's DNS "Domain property" needs no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key (optional; by default derived from SESSION_SECRET and served at /indexnow-key.txt)
INDEXNOW_KEY=

# Abandoned carts (optional): a cPanel cron job can call /api/cron?key=<this> every 15 minutes.
# Site traffic already runs the check every few minutes; the cron covers hours with no visitors.
CRON_SECRET=

# Domains → niche (comma-separated host=niche pairs)
NICHE_DOMAINS=sakinaeg.com=umrah,www.sakinaeg.com=umrah
