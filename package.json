{
  "name": "niche-engine",
  "private": true,
  "version": "0.1.0",
  "description": "One marketplace engine, many niche brands (Egypt). Sellers on Telegram, customers on the web + WhatsApp, payouts via Bosta COD.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "check:niches": "node packages/core/scripts/check-niches.ts",
    "publish:deploy": "bash scripts/publish-deploy.sh"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12"
  }
}
