# Copy to .env.local and fill in. Never commit real values.

# Admin panel password (required in production)
ADMIN_PASSWORD=

# Signs customer login cookies (required in production; any long random string)
SESSION_SECRET=

# Domains → niche (comma-separated host=niche pairs) — required in production
# NICHE_DOMAINS is listed at the bottom

# Only for a demo deployment without Supabase
ALLOW_DEMO_DATA=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Telegram seller bot (from BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Team alerts on Telegram (send /myid to the bot to get your number; several: comma-separated)
ADMIN_TELEGRAM_CHAT_IDS=

# Bosta (platform business account)
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=
# Optional: override the API base URL
BOSTA_API_BASE=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Meta Pixel + Conversions API, per niche (comma-separated niche=value pairs)
# Pixel id: Events Manager → Data sources. Token: Events Manager → Settings → Conversions API → Generate access token.
META_PIXEL_IDS=
META_CAPI_TOKENS=
# Optional: a code from Events Manager → Test events, while testing (remove for real traffic)
META_TEST_EVENT_CODE=

# Domains → niche (comma-separated host=niche pairs)
NICHE_DOMAINS=sakinaeg.com=umrah,www.sakinaeg.com=umrah
